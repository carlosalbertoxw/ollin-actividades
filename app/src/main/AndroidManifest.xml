<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Recordatorios. POST_NOTIFICATIONS se pide en tiempo de ejecucion desde
         Android 13; RECEIVE_BOOT_COMPLETED hace falta porque el sistema borra
         las alarmas al apagarse y sin el Ollin quedaria muda tras reiniciar.
         SCHEDULE_EXACT_ALARM no se da por concedido: desde Android 12 hay que
         autorizarlo a mano, y si no esta el aviso sale aproximado en vez de no
         salir. No se declara USE_EXACT_ALARM, que la tienda reserva a
         despertadores y calendarios. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Aviso de actualizaciones. Ollin se instala fuera de la tienda, asi que
         sin esto no hay ningun canal para enterarse de que se corrigio un
         fallo. Es todo lo que la red se usa: un GET diario a un JSON estatico
         del sitio, sin nada del telefono dentro y sin descargar nada. Ver
         ComprobadorActualizaciones y docs/seguridad.md. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OllinApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Ollin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ollin">
            <!-- El unico camino de entrada. La importacion de .xlsx se hace
                 desde Ajustes > Archivo, que abre el selector del sistema: no
                 se declara VIEW porque nada aqui lee el uri de un intent, y un
                 "Abrir con Ollin" que no hiciera nada seria peor que no estar. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".data.recordatorios.ReceptorRecordatorios"
            android:exported="false">
            <intent-filter>
                <action android:name="com.carlosalbertoxw.ollin.actividades.RECORDATORIO" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Tras actualizar la app tambien se replanifica: la
                     actualizacion cancela las alarmas puestas. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
